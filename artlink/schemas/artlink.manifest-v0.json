{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "A packageable or consumable unit of content.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "default": "",
          "title": "Format",
          "type": "string"
        },
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "media_type": {
          "default": "",
          "title": "Media Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provides": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Capability"
              },
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ]
          },
          "title": "Provides",
          "type": "array"
        },
        "requires": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Capability"
              },
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ]
          },
          "title": "Requires",
          "type": "array"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "uri": {
          "default": "",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "description": "A named capability that an artifact provides or requires.",
      "properties": {
        "kind": {
          "default": "",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Capability",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "manifest",
            "template"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "version": {
          "default": "",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "$id": "https://github.com/dau-dev/artlink/blob/main/artlink/schemas/artlink.manifest-v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "intent": {
      "default": "",
      "title": "Intent",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    },
    "schema": {
      "default": "artlink.manifest/v0",
      "title": "Schema",
      "type": "string"
    },
    "version": {
      "default": "",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "Manifest",
  "type": "object"
}
